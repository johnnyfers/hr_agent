# Required
ANTHROPIC_API_KEY=sk-ant-...

# Storage backend — leave DATABASE_URL unset to use SQLite at HR_AGENT_DB_PATH.
# In Docker, compose sets DATABASE_URL automatically.
# DATABASE_URL=postgresql://hr:hr@localhost:5432/hr_agent
HR_AGENT_DB_PATH=./hr_agent.db

HR_AGENT_MODEL=claude-sonnet-4-6
HR_AGENT_LOG_LEVEL=INFO
